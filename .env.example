# Copy to .env (git-ignored) and fill in. Never commit the real token.

# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel ->
# "Install and run a connector" (the long string after `--token`).
CLOUDFLARE_TUNNEL_TOKEN=

# Host UID/GID that owns this repo, so container-written artifacts match.
# Find yours with: id -u; id -g
PUID=1000
PGID=1000
